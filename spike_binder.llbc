cComment":" slice[..2].copy_from_slice(&slice[3..]); // compile fail!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" To work around this, we can use [`split_at_mut`] to create two distinct"},{"DocComment":" sub-slices from a slice:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut slice = [1, 2, 3, 4, 5];"},{"DocComment":""},{"DocComment":" {"},{"DocComment":"     let (left, right) = slice.split_at_mut(2);"},{"DocComment":"     left.copy_from_slice(&right[1..]);"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(slice, [4, 5, 3, 4, 5]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`clone_from_slice`]: slice::clone_from_slice"},{"DocComment":" [`split_at_mut`]: slice::split_at_mut"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":15,"beg":{"line":4323,"col":11},"end":{"line":4323,"col":15}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":4260}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[4384,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":4292},"Mut"]}]},{"HashConsedValue":[4385,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":4292},"Shared"]}]}],"output":{"Deduplicated":561}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":50,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["maybe_uninit",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":2184},"kind":"InherentImplBlock"}}},{"Ident":["zeroed",0]}],"span":{"data":{"file_id":19,"beg":{"line":479,"col":4},"end":{"line":479,"col":43}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates a new `MaybeUninit<T>` in an uninitialized state, with the memory being"},{"DocComment":" filled with `0` bytes. It depends on `T` whether that already makes for"},{"DocComment":" proper initialization. For example, `MaybeUninit<usize>::zeroed()` is initialized,"},{"DocComment":" but `MaybeUninit<&'static i32>::zeroed()` is not because references must not"},{"DocComment":" be null."},{"DocComment":""},{"DocComment":" Note that if `T` has padding bytes, those bytes are *not* preserved when the"},{"DocComment":" `MaybeUninit<T>` value is returned from this function, so those bytes will *not* be zeroed."},{"DocComment":""},{"DocComment":" Note that dropping a `MaybeUninit<T>` will never call `T`'s drop code."},{"DocComment":" It is your responsibility to make sure `T` gets dropped if it got initialized."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" Correct usage of this function: initializing a struct with zero, where all"},{"DocComment":" fields of the struct can hold the bit-pattern 0 as a valid value."},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" let x = MaybeUninit::<(u8, bool)>::zeroed();"},{"DocComment":" let x = unsafe { x.assume_init() };"},{"DocComment":" assert_eq!(x, (0, false));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This can be used in const contexts, such as to indicate the end of static arrays for"},{"DocComment":" plugin registration."},{"DocComment":""},{"DocComment":" *Incorrect* usage of this function: calling `x.zeroed().assume_init()`"},{"DocComment":" when `0` is not a valid bit-pattern for the type:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" enum NotZero { One = 1, Two = 2 }"},{"DocComment":""},{"DocComment":" let x = MaybeUninit::<(u8, NotZero)>::zeroed();"},{"DocComment":" let x = unsafe { x.assume_init() };"},{"DocComment":" // Inside a pair, we create a `NotZero` that does not have a valid discriminant."},{"DocComment":" // This is undefined behavior. ⚠️"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"maybe_uninit_zeroed"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[],"output":{"HashConsedValue":[4386,{"Adt":{"id":{"Adt":25},"generics":{"regions":[],"types":[{"Deduplicated":4260}],"const_generics":[],"trait_refs":[]}}}]}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":51,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["maybe_uninit",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":2184},"kind":"InherentImplBlock"}}},{"Ident":["as_mut_ptr",0]}],"span":{"data":{"file_id":19,"beg":{"line":658,"col":4},"end":{"line":658,"col":48}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Gets a mutable pointer to the contained value. Reading from this pointer or turning it"},{"DocComment":" into a reference is undefined behavior unless the `MaybeUninit<T>` is initialized."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Correct usage of this method:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" let mut x = MaybeUninit::<Vec<u32>>::uninit();"},{"DocComment":" x.write(vec![0, 1, 2]);"},{"DocComment":" // Create a reference into the `MaybeUninit<Vec<u32>>`."},{"DocComment":" // This is okay because we initialized it."},{"DocComment":" let x_vec = unsafe { &mut *x.as_mut_ptr() };"},{"DocComment":" x_vec.push(3);"},{"DocComment":" assert_eq!(x_vec.len(), 4);"},{"DocComment":" # // Prevent leaks for Miri"},{"DocComment":" # unsafe { MaybeUninit::assume_init_drop(&mut x); }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" *Incorrect* usage of this method:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" let mut x = MaybeUninit::<Vec<u32>>::uninit();"},{"DocComment":" let x_vec = unsafe { &mut *x.as_mut_ptr() };"},{"DocComment":" // We have created a reference to an uninitialized vector! This is undefined behavior. ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" (Notice that the rules around references to uninitialized data are not finalized yet, but"},{"DocComment":" until they are, it is advisable to avoid them.)"}],"inline":"Always","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[4387,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":4386},"Mut"]}]}],"output":{"HashConsedValue":[4388,{"RawPtr":[{"Deduplicated":4260},"Mut"]}]}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":52,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ptr",0]},{"Ident":["mut_ptr",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":2304},"kind":"InherentImplBlock"}}},{"Ident":["cast",0]}],"span":{"data":{"file_id":20,"beg":{"line":31,"col":4},"end":{"line":31,"col":40}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Casts to a pointer of another type."}],"inline":"Always","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"ptr_cast"},"generics":{"regions":[],"types":[{"index":0,"name":"T"},{"index":1,"name":"U"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":4388}],"output":{"HashConsedValue":[4321,{"RawPtr":[{"Deduplicated":4267},"Mut"]}]}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":53,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["maybe_uninit",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":2184},"kind":"InherentImplBlock"}}},{"Ident":["assume_init_ref",0]}],"span":{"data":{"file_id":19,"beg":{"line":893,"col":4},"end":{"line":893,"col":52}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Gets a shared reference to the contained value."},{"DocComment":""},{"DocComment":" This can be useful when we want to access a `MaybeUninit` that has been"},{"DocComment":" initialized but don't have ownership of the `MaybeUninit` (preventing the use"},{"DocComment":" of `.assume_init()`)."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" Calling this when the content is not yet fully initialized causes undefined"},{"DocComment":" behavior: it is up to the caller to guarantee that the `MaybeUninit<T>` really"},{"DocComment":" is in an initialized state."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ### Correct usage of this method:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" let mut x = MaybeUninit::<Vec<u32>>::uninit();"},{"DocComment":" # let mut x_mu = x;"},{"DocComment":" # let mut x = &mut x_mu;"},{"DocComment":" // Initialize `x`:"},{"DocComment":" x.write(vec![1, 2, 3]);"},{"DocComment":" // Now that our `MaybeUninit<_>` is known to be initialized, it is okay to"},{"DocComment":" // create a shared reference to it:"},{"DocComment":" let x: &Vec<u32> = unsafe {"},{"DocComment":"     // SAFETY: `x` has been initialized."},{"DocComment":"     x.assume_init_ref()"},{"DocComment":" };"},{"DocComment":" assert_eq!(x, &vec![1, 2, 3]);"},{"DocComment":" # // Prevent leaks for Miri"},{"DocComment":" # unsafe { MaybeUninit::assume_init_drop(&mut x_mu); }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ### *Incorrect* usages of this method:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" let x = MaybeUninit::<Vec<u32>>::uninit();"},{"DocComment":" let x_vec: &Vec<u32> = unsafe { x.assume_init_ref() };"},{"DocComment":" // We have created a reference to an uninitialized vector! This is undefined behavior. ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" use std::{cell::Cell, mem::MaybeUninit};"},{"DocComment":""},{"DocComment":" let b = MaybeUninit::<Cell<bool>>::uninit();"},{"DocComment":" // Initialize the `MaybeUninit` using `Cell::set`:"},{"DocComment":" unsafe {"},{"DocComment":"     b.assume_init_ref().set(true);"},{"DocComment":"     //^^^^^^^^^^^^^^^ Reference to an uninitialized `Cell<bool>`: UB!"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":"Always","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[4389,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":4386},"Shared"]}]}],"output":{"Deduplicated":4290}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":54,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["maybe_uninit",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":2184},"kind":"InherentImplBlock"}}},{"Ident":["assume_init",0]}],"span":{"data":{"file_id":19,"beg":{"line":721,"col":4},"end":{"line":721,"col":46}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Extracts the value from the `MaybeUninit<T>` container. This is a great way"},{"DocComment":" to ensure that the data will get dropped, because the resulting `T` is"},{"DocComment":" subject to the usual drop handling."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" It is up to the caller to guarantee that the `MaybeUninit<T>` really is in an initialized"},{"DocComment":" state, i.e., a state that is considered [\"valid\" for type `T`][validity]. Calling this when"},{"DocComment":" the content is not yet fully initialized causes immediate undefined behavior. The"},{"DocComment":" [type-level documentation][inv] contains more information about this initialization"},{"DocComment":" invariant."},{"DocComment":""},{"DocComment":" It is a common mistake to assume that this function is safe to call on integers because they"},{"DocComment":" can hold all bit patterns. It is also a common mistake to think that calling this function"},{"DocComment":" is UB if any byte is uninitialized. Both of these assumptions are wrong. If that is"},{"DocComment":" surprising to you, please read the [type-level documentation][inv]."},{"DocComment":""},{"DocComment":" [inv]: #initialization-invariant"},{"DocComment":" [validity]: ../../reference/behavior-considered-undefined.html#r-undefined.validity"},{"DocComment":""},{"DocComment":" On top of that, remember that most types have additional invariants beyond merely"},{"DocComment":" being considered initialized at the type level. For example, a `1`-initialized [`Vec<T>`]"},{"DocComment":" is considered initialized (under the current implementation; this does not constitute"},{"DocComment":" a stable guarantee) because the only requirement the compiler knows about it"},{"DocComment":" is that the data pointer must be non-null. Creating such a `Vec<T>` does not cause"},{"DocComment":" *immediate* undefined behavior, but will cause undefined behavior with most"},{"DocComment":" safe operations (including dropping it)."},{"DocComment":""},{"DocComment":" [`Vec<T>`]: ../../std/vec/struct.Vec.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Correct usage of this method:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" let mut x = MaybeUninit::<bool>::uninit();"},{"DocComment":" x.write(true);"},{"DocComment":" let x_init = unsafe { x.assume_init() };"},{"DocComment":" assert_eq!(x_init, true);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" *Incorrect* usage of this method:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # #![allow(invalid_value)]"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" let x: i32 = unsafe { MaybeUninit::uninit().assume_init() }; // undefined behavior! ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" See the [type-level documentation][#examples] for more examples."}],"inline":"Always","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"assume_init"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":4386}],"output":{"Deduplicated":4260}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":55,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["hint",0]},{"Ident":["unreachable_unchecked",0]}],"span":{"data":{"file_id":22,"beg":{"line":103,"col":0},"end":{"line":103,"col":48}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Informs the compiler that the site which is calling this function is not"},{"DocComment":" reachable, possibly enabling further optimizations."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" Reaching this function is *Undefined Behavior*."},{"DocComment":""},{"DocComment":" As the compiler assumes that all forms of Undefined Behavior can never"},{"DocComment":" happen, it will eliminate all branches in the surrounding code that it can"},{"DocComment":" determine will invariably lead to a call to `unreachable_unchecked()`."},{"DocComment":""},{"DocComment":" If the assumptions embedded in using this function turn out to be wrong -"},{"DocComment":" that is, if the site which is calling `unreachable_unchecked()` is actually"},{"DocComment":" reachable at runtime - the compiler may have generated nonsensical machine"},{"DocComment":" instructions for this situation, including in seemingly unrelated code,"},{"DocComment":" causing difficult-to-debug problems."},{"DocComment":""},{"DocComment":" Use this function sparingly. Consider using the [`unreachable!`] macro,"},{"DocComment":" which may prevent some optimizations but will safely panic in case it is"},{"DocComment":" actually reached at runtime. Benchmark your code to find out if using"},{"DocComment":" `unreachable_unchecked()` comes with a performance benefit."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" `unreachable_unchecked()` can be used in situations where the compiler"},{"DocComment":" can't prove invariants that were previously established. Such situations"},{"DocComment":" have a higher chance of occurring if those invariants are upheld by"},{"DocComment":" external code that the compiler can't analyze."},{"DocComment":" ```"},{"DocComment":" fn prepare_inputs(divisors: &mut Vec<u32>) {"},{"DocComment":"     // Note to future-self when making changes: The invariant established"},{"DocComment":"     // here is NOT checked in `do_computation()`; if this changes, you HAVE"},{"DocComment":"     // to change `do_computation()`."},{"DocComment":"     divisors.retain(|divisor| *divisor != 0)"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" /// # Safety"},{"DocComment":" /// All elements of `divisor` must be non-zero."},{"DocComment":" unsafe fn do_computation(i: u32, divisors: &[u32]) -> u32 {"},{"DocComment":"     divisors.iter().fold(i, |acc, divisor| {"},{"DocComment":"         // Convince the compiler that a division by zero can't happen here"},{"DocComment":"         // and a check is not needed below."},{"DocComment":"         if *divisor == 0 {"},{"DocComment":"             // Safety: `divisor` can't be zero because of `prepare_inputs`,"},{"DocComment":"             // but the compiler does not know about this. We *promise*"},{"DocComment":"             // that we always call `prepare_inputs`."},{"DocComment":"             unsafe { std::hint::unreachable_unchecked() }"},{"DocComment":"         }"},{"DocComment":"         // The compiler would normally introduce a check here that prevents"},{"DocComment":"         // a division by zero. However, if `divisor` was zero, the branch"},{"DocComment":"         // above would reach what we explicitly marked as unreachable."},{"DocComment":"         // The compiler concludes that `divisor` can't be zero at this point"},{"DocComment":"         // and removes the - now proven useless - check."},{"DocComment":"         acc / divisor"},{"DocComment":"     })"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut divisors = vec![2, 0, 4];"},{"DocComment":" prepare_inputs(&mut divisors);"},{"DocComment":" let result = unsafe {"},{"DocComment":"     // Safety: prepare_inputs() guarantees that divisors is non-zero"},{"DocComment":"     do_computation(100, &divisors)"},{"DocComment":" };"},{"DocComment":" assert_eq!(result, 12);"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" While using `unreachable_unchecked()` is perfectly sound in the following"},{"DocComment":" example, as the compiler is able to prove that a division by zero is not"},{"DocComment":" possible, benchmarking reveals that `unreachable_unchecked()` provides"},{"DocComment":" no benefit over using [`unreachable!`], while the latter does not introduce"},{"DocComment":" the possibility of Undefined Behavior."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn div_1(a: u32, b: u32) -> u32 {"},{"DocComment":"     use std::hint::unreachable_unchecked;"},{"DocComment":""},{"DocComment":"     // `b.saturating_add(1)` is always positive (not zero),"},{"DocComment":"     // hence `checked_div` will never return `None`."},{"DocComment":"     // Therefore, the else branch is unreachable."},{"DocComment":"     a.checked_div(b.saturating_add(1))"},{"DocComment":"         .unwrap_or_else(|| unsafe { unreachable_unchecked() })"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(div_1(7, 0), 7);"},{"DocComment":" assert_eq!(div_1(9, 1), 4);"},{"DocComment":" assert_eq!(div_1(11, u32::MAX), 0);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[],"output":{"Deduplicated":1027}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":56,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["option",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":1360},"kind":"InherentImplBlock"}}},{"Ident":["unwrap_unchecked",0]}],"span":{"data":{"file_id":7,"beg":{"line":1125,"col":4},"end":{"line":1125,"col":51}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns the contained [`Some`] value, consuming the `self` value,"},{"DocComment":" without checking that the value is not [`None`]."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" Calling this method on [`None`] is *[undefined behavior]*."},{"DocComment":""},{"DocComment":" [undefined behavior]: https://doc.rust-lang.org/reference/behavior-considered-undefined.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let x = Some(\"air\");"},{"DocComment":" assert_eq!(unsafe { x.unwrap_unchecked() }, \"air\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" let x: Option<&str> = None;"},{"DocComment":" assert_eq!(unsafe { x.unwrap_unchecked() }, \"air\"); // Undefined behavior!"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{