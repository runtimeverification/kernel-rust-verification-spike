zeroed) buffer by value and returns it filled. Same\n        // fill-then-validate protocol and control flow; only the buffer-passing\n        // convention differs.\n        R: FnOnce([u8; OBJECT_SIZE]) -> Result<[u8; OBJECT_SIZE]>,\n    {\n        // REMODEL: zeroed byte array instead of `MaybeUninit::<BinderObject>::zeroed()`.\n        // REMODEL: fill the bytes directly; the kernel casts the\n        // `MaybeUninit<BinderObject>` to `&mut [u8; N]` via a raw pointer here.\n        let bytes = fill([0u8; OBJECT_SIZE])?;\n        let obj = BinderObjectBytes(bytes);\n\n        // REMODEL: read the tag with a typed accessor instead of\n        // `unsafe { obj.assume_init_ref().hdr.type_ }`.\n        let type_ = obj.hdr_type();\n        if type_to_size(type_).is_none() {\n            // The value of the type header was invalid.\n            return Err(EINVAL);\n        }\n\n        // REMODEL: the validated bytes *are* the object; no `assume_init`.\n        Ok(obj)\n    }","attr_info":{"attributes":[{"DocComment":" Use the provided reader closure to construct a `BinderObjectBytes`."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"R"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":0,"beg":{"line":230,"col":11},"end":{"line":230,"col":65}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":13,"generics":{"regions":[],"types":[{"Deduplicated":4145},{"Deduplicated":2105},{"Deduplicated":2076}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":4145}],"output":{"Deduplicated":1346}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":0,"beg":{"line":221,"col":4},"end":{"line":248,"col":5}},"generated