t":""},{"DocComment":" To interact with a `Formatter`, you'll call various methods to change the"},{"DocComment":" various options related to formatting. For examples, please see the"},{"DocComment":" documentation of the methods defined on `Formatter` below."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Formatter"},"generics":{"regions":[{"index":0,"name":"'a","mutability":"Mutable"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[{"regions":[],"skip_binder":[{"Var":{"Free":0}},{"Var":{"Free":0}}]}],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":24,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[16,0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":21,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Error",0]}],"span":{"data":{"file_id":1,"beg":{"line":109,"col":0},"end":{"line":109,"col":16}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The error type which is returned from formatting a message into a stream."},{"DocComment":""},{"DocComment":" This type does not support transmission of an error other than that an error"},{"DocComment":" occurred. This is because, despite the existence of this error,"},{"DocComment":" string formatting is considered an infallible operation."},{"DocComment":" `fmt()` implementors should not return this `Error` unless they received it from their"},{"DocComment":" [`Formatter`]. The only time your code should create a new instance of this"},{"DocComment":" error is when implementing `fmt::Write`, in order to cancel the formatting operation when"},{"DocComment":" writing to the underlying stream fails."},{"DocComment":""},{"DocComment":" Any extra information must be arranged to be transmitted through some other means,"},{"DocComment":" such as storing it in a field to be consulted after the formatting operation has been"},{"DocComment":" cancelled. (For example, this is how [`std::io::Write::write_fmt()`] propagates IO errors"},{"DocComment":" during writing.)"},{"DocComment":""},{"DocComment":" This type, `fmt::Error`, should not be"},{"DocComment":" confused with [`std::io::Error`] or [`std::error::Error`], which you may also"},{"DocComment":" have in scope."},{"DocComment":""},{"DocComment":" [`std::io::Error`]: ../../std/io/struct.Error.html"},{"DocComment":" [`std::io::Write::write_fmt()`]: ../../std/io/trait.Write.html#method.write_fmt"},{"DocComment":" [`std::error::Error`]: ../../std/error/trait.Error.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::fmt::{self, write};"},{"DocComment":""},{"DocComment":" let mut output = String::new();"},{"DocComment":" if let Err(fmt::Error) = write(&mut output, format_args!(\"Hello {}!\", \"world\")) {"},{"DocComment":"     panic!(\"An error occurred\");"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},null,{"def_id":23,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["range",0]},{"Ident":["Range",0]}],"span":{"data":{"file_id":16,"beg":{"line":82,"col":0},"end":{"line":82,"col":21}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A (half-open) range bounded inclusively below and exclusively above"},{"DocComment":" (`start..end`)."},{"DocComment":""},{"DocComment":" The range `start..end` contains all values with `start <= x < end`."},{"DocComment":" It is empty if `start >= end`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The `start..end` syntax is a `Range`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!((3..5), std::ops::Range { start: 3, end: 5 });"},{"DocComment":" assert_eq!(3 + 4 + 5, (3..6).sum());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let arr = [0, 1, 2, 3, 4];"},{"DocComment":" assert_eq!(arr[ ..  ], [0, 1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[ .. 3], [0, 1, 2      ]);"},{"DocComment":" assert_eq!(arr[ ..=3], [0, 1, 2, 3   ]);"},{"DocComment":" assert_eq!(arr[1..  ], [   1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[1.. 3], [   1, 2      ]); // This is a `Range`"},{"DocComment":" assert_eq!(arr[1..=3], [   1, 2, 3   ]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Range"},"generics":{"regions":[],"types":[{"index":0,"name":"Idx"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":16,"beg":{"line":85,"col":4},"end":{"line":85,"col":18}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" The lower bound of the range (inclusive)."}],"inline":null,"rename":null,"public":true},"name":"start","ty":{"Deduplicated":4260}},{"span":{"data":{"file_id":16,"beg":{"line":88,"col":4},"end":{"line":88,"col":16}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" The upper bound of the range (exclusive)."}],"inline":null,"rename":null,"public":true},"name":"end","ty":{"Deduplicated":4260}}]},"layout":[],"ptr_metadata":"None"},{"def_id":24,"item_meta":{"name":[{"Ident":["spike_binder",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":868},"kind":"InherentImplBlock"}}},{"Ident":["read_from",0]},{"Ident":["closure",0]}],"span":{"data":{"file_id":0,"beg":{"line":230,"col":43},"end":{"line":234,"col":9}},"generated_from_span":null},"source_text":"|slice| {\n            let read_len = usize::min(slice.len(), reader.len());\n            reader.clone_reader().read_slice(&mut slice[..read_len])?;\n            Ok(())\n        }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":{"Closure":{"info":{"kind":"FnOnce","fn_once_impl":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":38,"generics":{"regions":[{"Var":{"Free":0}},{"Var":{"Free":1}},{"Var":{"Bound":[0,0]}}],"types":[],"const_generics":[],"trait_refs":[]}}},"fn_mut_impl":null,"fn_impl":null,"signature":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[2091,{"Ref":[{"Var":{"Bound":[0,0]}},{"HashConsedValue":[2090,{"Array":[{"Deduplicated":809},{"kind":{"Literal":{"Scalar":{"Unsigned":["Usize","40"]}}},"ty":{"Deduplicated":813}}]}]},"Mut"]}]}],"output":{"HashConsedValue":[1304,{"Adt":{"id":{"Adt":6},"generics":{"regions":[],"types":[{"HashConsedValue":[561,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":527}],"const_generics":[],"trait_refs":[]}}}]}}}}}},"kind":{"Struct":[{"span":{"data":{"file_id":0,"beg":{"line":230,"col":43},"end":{"line":234,"col":9}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":null,"ty":{"HashConsedValue":[4269,{"Ref":[{"Var":{"Free":0}},{"HashConsedValue":[4268,{"Adt":{"id":{"Adt":2},"generics":{"regions":[{"Var":{"Free":1}}],"types":[],"const_generics":[],"trait_refs":[]}}}]},"Shared"]}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":8,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":25,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["maybe_uninit",0]},{"Ident":["MaybeUninit",0]}],"span":{"data":{"file_id":19,"beg":{"line":355,"col":0},"end":{"line":355,"col":24}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A wrapper type to construct uninitialized instances of `T`."},{"DocComment":""},{"DocComment":" # Initialization invariant"},{"DocComment":""},{"DocComment":" The compiler, in general, assumes that a variable is [properly initialized or \"valid\"][validity]"},{"DocComment":" according to the requirements of the variable's type. For example, a variable of"},{"DocComment":" reference type must be aligned and non-null. This is an invariant that must"},{"DocComment":" *always* be upheld, even in unsafe code. As a consequence, zero-initializing a"},{"DocComment":" variable of reference type causes instantaneous undefined behavior,"},{"DocComment":" no matter whether that reference ever gets used to access memory:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # #![allow(invalid_value)]"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let x: &i32 = unsafe { mem::zeroed() }; // undefined behavior! ⚠️"},{"DocComment":" // The equivalent code with `MaybeUninit<&i32>`:"},{"DocComment":" let x: &i32 = unsafe { MaybeUninit::zeroed().assume_init() }; // undefined behavior! ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This is exploited by the compiler for various optimizations, such as eliding"},{"DocComment":" run-time checks and optimizing `enum` layout."},{"DocComment":""},{"DocComment":" Similarly, entirely uninitialized memory may have any content, while a `bool` must"},{"DocComment":" always be `true` or `false`. Hence, creating an uninitialized `bool` is undefined behavior:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # #![allow(invalid_value)]"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let b: bool = unsafe { mem::uninitialized() }; // undefined behavior! ⚠️"},{"DocComment":" // The equivalent code with `MaybeUninit<bool>`:"},{"DocComment":" let b: bool = unsafe { MaybeUninit::uninit().assume_init() }; // undefined behavior! ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Moreover, uninitialized memory is special in that it does not have a fixed value (\"fixed\""},{"DocComment":" meaning \"it won't change without being written to\"). Reading the same uninitialized byte"},{"DocComment":" multiple times can give different results. This makes it undefined behavior to have"},{"DocComment":" uninitialized data in a variable even if that variable has an integer type, which otherwise can"},{"DocComment":" hold any *fixed* bit pattern:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # #![allow(invalid_value)]"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let x: i32 = unsafe { mem::uninitialized() }; // undefined behavior! ⚠️"},{"DocComment":" // The equivalent code with `MaybeUninit<i32>`:"},{"DocComment":" let x: i32 = unsafe { MaybeUninit::uninit().assume_init() }; // undefined behavior! ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Conversely, sometimes it is okay to not initialize *all* bytes of a `MaybeUninit`"},{"DocComment":" before calling `assume_init`. For instance, padding bytes do not have to be initialized."},{"DocComment":" See the field-by-field struct initialization example below for a case of that."},{"DocComment":""},{"DocComment":" On top of that, remember that most types have additional invariants beyond merely"},{"DocComment":" being considered initialized at the type level. For example, a `1`-initialized [`Vec<T>`]"},{"DocComment":" is considered initialized (under the current implementation; this does not constitute"},{"DocComment":" a stable guarantee) because the only requirement the compiler knows about it"},{"DocComment":" is that the data pointer must be non-null. Creating such a `Vec<T>` does not cause"},{"DocComment":" *immediate* undefined behavior, but will cause undefined behavior with most"},{"DocComment":" safe operations (including dropping it)."},{"DocComment":""},{"DocComment":" [`Vec<T>`]: ../../std/vec/struct.Vec.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` serves to enable unsafe code to deal with uninitialized data."},{"DocComment":" It is a signal to the compiler indicating that the data here might *not*"},{"DocComment":" be initialized:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" // Create an explicitly uninitialized reference. The compiler knows that data inside"},{"DocComment":" // a `MaybeUninit<T>` may be invalid, and hence this is not UB:"},{"DocComment":" let mut x = MaybeUninit::<&i32>::uninit();"},{"DocComment":" // Set it to a valid value."},{"DocComment":" x.write(&0);"},{"DocComment":" // Extract the initialized data -- this is only allowed *after* properly"},{"DocComment":" // initializing `x`!"},{"DocComment":" let x = unsafe { x.assume_init() };"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The compiler then knows to not make any incorrect assumptions or optimizations on this code."},{"DocComment":""},{"DocComment":" You can think of `MaybeUninit<T>` as being a bit like `Option<T>` but without"},{"DocComment":" any of the run-time tracking and without any of the safety checks."},{"DocComment":""},{"DocComment":" ## out-pointers"},{"DocComment":""},{"DocComment":" You can use `MaybeUninit<T>` to implement \"out-pointers\": instead of returning data"},{"DocComment":" from a function, pass it a pointer to some (uninitialized) memory to put the"},{"DocComment":" result into. This can be useful when it is important for the caller to control"},{"DocComment":" how the memory the result is stored in gets allocated, and you want to avoid"},{"DocComment":" unnecessary moves."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" unsafe fn make_vec(out: *mut Vec<i32>) {"},{"DocComment":"     // `write` does not drop the old contents, which is important."},{"DocComment":"     unsafe { out.write(vec![1, 2, 3]); }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut v = MaybeUninit::uninit();"},{"DocComment":" unsafe { make_vec(v.as_mut_ptr()); }"},{"DocComment":" // Now we know `v` is initialized! This also makes sure the vector gets"},{"DocComment":" // properly dropped."},{"DocComment":" let v = unsafe { v.assume_init() };"},{"DocComment":" assert_eq!(&v, &[1, 2, 3]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Initializing an array element-by-element"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` can be used to initialize a large array element-by-element:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let data = {"},{"DocComment":"     // Create an uninitialized array of `MaybeUninit`."},{"DocComment":"     let mut data: [MaybeUninit<Vec<u32>>; 1000] = [const { MaybeUninit::uninit() }; 1000];"},{"DocComment":""},{"DocComment":"     // Dropping a `MaybeUninit` does nothing, so if there is a panic during this loop,"},{"DocComment":"     // we have a memory leak, but there is no memory safety issue."},{"DocComment":"     for elem in &mut data[..] {"},{"DocComment":"         elem.write(vec![42]);"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     // Everything is initialized. Transmute the array to the"},{"DocComment":"     // initialized type."},{"DocComment":"     unsafe { mem::transmute::<_, [Vec<u32>; 1000]>(data) }"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" assert_eq!(&data[0], &[42]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also work with partially initialized arrays, which could"},{"DocComment":" be found in low-level datastructures."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" // Create an uninitialized array of `MaybeUninit`."},{"DocComment":" let mut data: [MaybeUninit<String>; 1000] = [const { MaybeUninit::uninit() }; 1000];"},{"DocComment":" // Count the number of elements we have assigned."},{"DocComment":" let mut data_len: usize = 0;"},{"DocComment":""},{"DocComment":" for elem in &mut data[0..500] {"},{"DocComment":"     elem.write(String::from(\"hello\"));"},{"DocComment":"     data_len += 1;"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // For each item in the array, drop if we allocated it."},{"DocComment":" for elem in &mut data[0..data_len] {"},{"DocComment":"     unsafe { elem.assume_init_drop(); }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Initializing a struct field-by-field"},{"DocComment":""},{"DocComment":" You can use `MaybeUninit<T>` and the [`&raw mut`] syntax to initialize structs field by field:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" #[derive(Debug, PartialEq)]"},{"DocComment":" pub struct Foo {"},{"DocComment":"     name: String,"},{"DocComment":"     list: Vec<u8>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let foo = {"},{"DocComment":"     let mut uninit: MaybeUninit<Foo> = MaybeUninit::uninit();"},{"DocComment":"     let ptr = uninit.as_mut_ptr();"},{"DocComment":""},{"DocComment":"     // Initializing the `name` field"},{"DocComment":"     // Using `write` instead of assignment via `=` to not call `drop` on the"},{"DocComment":"     // old, uninitialized value."},{"DocComment":"     unsafe { (&raw mut (*ptr).name).write(\"Bob\".to_string()); }"},{"DocComment":""},{"DocComment":"     // Initializing the `list` field"},{"DocComment":"     // If there is a panic here, then the `String` in the `name` field leaks."},{"DocComment":"     unsafe { (&raw mut (*ptr).list).write(vec![0, 1, 2]); }"},{"DocComment":""},{"DocComment":"     // All the fields are initialized, so we call `assume_init` to get an initialized Foo."},{"DocComment":"     unsafe { uninit.assume_init() }"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     foo,"},{"DocComment":"     Foo {"},{"DocComment":"         name: \"Bob\".to_string(),"},{"DocComment":"         list: vec![0, 1, 2]"},{"DocComment":"     }"},{"DocComment":" );"},{"DocComment":" ```"},{"DocComment":" [`&raw mut`]: https://doc.rust-lang.org/reference/types/pointer.html#r-type.pointer.raw.constructor"},{"DocComment":" [validity]: ../../reference/behavior-considered-undefined.html#r-undefined.validity"},{"DocComment":""},{"DocComment":" Note that we have not initialized the padding, but that's fine -- it does not have to be"},{"DocComment":" initialized. In fact, even if we had initialized the padding in `uninit`, those bytes would be"},{"DocComment":" lost when copying the result: no matter the contents of the padding bytes in `uninit`, they will"},{"DocComment":" always be uninitialized in `foo`."},{"DocComment":""},{"DocComment":" # Layout"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` is guaranteed to have the same size, alignment, and ABI as `T`:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":" assert_eq!(size_of::<MaybeUninit<u64>>(), size_of::<u64>());"},{"DocComment":" assert_eq!(align_of::<MaybeUninit<u64>>(), align_of::<u64>());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" However remember that a type *containing* a `MaybeUninit<T>` is not necessarily the same"},{"DocComment":" layout; Rust does not in general guarantee that the fields of a `Foo<T>` have the same order as"},{"DocComment":" a `Foo<U>` even if `T` and `U` have the same size and alignment. Furthermore because any bit"},{"DocComment":" value is valid for a `MaybeUninit<T>` the compiler can't apply non-zero/niche-filling"},{"DocComment":" optimizations, potentially resulting in a larger size:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" # use std::mem::MaybeUninit;"},{"DocComment":" assert_eq!(size_of::<Option<bool>>(), 1);"},{"DocComment":" assert_eq!(size_of::<Option<MaybeUninit<bool>>>(), 2);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If `T` is FFI-safe, then so is `MaybeUninit<T>`."},{"DocComment":""},{"DocComment":" While `MaybeUninit` is `#[repr(transparent)]` (indicating it guarantees the same size,"},{"DocComment":" alignment, and ABI as `T`), this does *not* change any of the previous caveats. `Option<T>` and"},{"DocComment":" `Option<MaybeUninit<T>>` may still have different sizes, and types containing a field of type"},{"DocComment":" `T` may be laid out (and sized) differently than if that field were `MaybeUninit<T>`."},{"DocComment":" `MaybeUninit` is a union type, and `#[repr(transparent)]` on unions is unstable (see [the"},{"DocComment":" tracking issue](https://github.com/rust-lang/rust/issues/60405)). Over time, the exact"},{"DocComment":" guarantees of `#[repr(transparent)]` on unions may evolve, and `MaybeUninit` may or may not"},{"DocComment":" remain `#[repr(transparent)]`. That said, `MaybeUninit<T>` will *always* guarantee that it has"},{"DocComment":" the same size, alignment, and ABI as `T`; it's just that the way `MaybeUninit` implements that"},{"DocComment":" guarantee may evolve."},{"DocComment":""},{"DocComment":" Note that even though `T` and `MaybeUninit<T>` are ABI compatible it is still unsound to"},{"DocComment":" transmute `&mut T` to `&mut MaybeUninit<T>` and expose that to safe code because it would allow"},{"DocComment":" safe code to access uninitialized memory:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" use core::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" fn unsound_transmute<T>(val: &mut T) -> &mut MaybeUninit<T> {"},{"DocComment":"     unsafe { core::mem::transmute(val) }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     let mut code = 0;"},{"DocComment":"     let code = &mut code;"},{"DocComment":"     let code2 = unsound_transmute(code);"},{"DocComment":"     *code2 = MaybeUninit::uninit();"},{"DocComment":"     std::process::exit(*code); // UB! Accessing uninitialized memory."},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Validity"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` has no validity requirements – any sequence of [bytes] of"},{"DocComment":" the appropriate length, initialized or uninitialized, are a valid"},{"DocComment":" representation."},{"DocComment":""},{"DocComment":" Moving or copying a value of type `MaybeUninit<T>` (i.e., performing a"},{"DocComment":" \"typed copy\") will exactly preserve the contents, including the"},{"DocComment":" [provenance], of all non-padding bytes of type `T` in the value's"},{"DocComment":" representation."},{"DocComment":""},{"DocComment":" Therefore `MaybeUninit` can be used to perform a round trip of a value from"},{"DocComment":" type `T` to type `MaybeUninit<U>` then back to type `T`, while preserving"},{"DocComment":" the original value, if two conditions are met. One, type `U` must have the"},{"DocComment":" same size as type `T`. Two, for all byte offsets where type `U` has padding,"},{"DocComment":" the corresponding bytes in the representation of the value must be"},{"DocComment":" uninitialized."},{"DocComment":""},{"DocComment":" For example, due to the fact that the type `[u8; size_of::<T>]` has no"},{"DocComment":" padding, the following is sound for any type `T` and will return the"},{"DocComment":" original value:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # use core::mem::{MaybeUninit, transmute};"},{"DocComment":" # struct T;"},{"DocComment":" fn identity(t: T) -> T {"},{"DocComment":"     unsafe {"},{"DocComment":"         let u: MaybeUninit<[u8; size_of::<T>()]> = transmute(t);"},{"DocComment":"         transmute(u) // OK."},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note: Copying a value that contains references may implicitly reborrow them"},{"DocComment":" causing the provenance of the returned value to differ from that of the"},{"DocComment":" original. This applies equally to the trivial identity function:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" fn trivial_identity<T>(t: T) -> T { t }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note: Moving or copying a value whose representation has initialized bytes"},{"DocComment":" at byte offsets where the type has padding may lose the value of those"},{"DocComment":" bytes, so while the original value will be preserved, the original"},{"DocComment":" *representation* of that value as bytes may not be. Again, this applies"},{"DocComment":" equally to `trivial_identity`."},{"DocComment":""},{"DocComment":" Note: Performing this round trip when type `U` has padding at byte offsets"},{"DocComment":" where the representation of the original value has initialized bytes may"},{"DocComment":" produce undefined behavior or a different value. For example, the following"},{"DocComment":" is unsound since `T` requires all bytes to be initialized:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # use core::mem::{MaybeUninit, transmute};"},{"DocComment":" #[repr(C)] struct T([u8; 4]);"},{"DocComment":" #[repr(C)] struct U(u8, u16);"},{"DocComment":" fn unsound_identity(t: T) -> T {"},{"DocComment":"     unsafe {"},{"DocComment":"         let u: MaybeUninit<U> = transmute(t);"},{"DocComment":"         transmute(u) // UB."},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Conversely, the following is sound since `T` allows uninitialized bytes in"},{"DocComment":" the representation of a value, but the round trip may alter the value:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # use core::mem::{MaybeUninit, transmute};"},{"DocComment":" #[repr(C)] struct T(MaybeUninit<[u8; 4]>);"},{"DocComment":" #[repr(C)] struct U(u8, u16);"},{"DocComment":" fn non_identity(t: T) -> T {"},{"DocComment":"     unsafe {"},{"DocComment":"         // May lose an initialized byte."},{"DocComment":"         let u: MaybeUninit<U> = transmute(t);"},{"DocComment":"         transmute(u)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [bytes]: ../../reference/memory-model.html#bytes"},{"DocComment":" [provenance]: crate::ptr#provenance"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"maybe_uninit"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},null,null,null,null,{"def_id":30,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["range",0]},{"Ident":["RangeTo",0]}],"span":{"data":{"file_id":16,"beg":{"line":281,"col":0},"end":{"line":281,"col":23}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A range only bounded exclusively above (`..end`)."},{"DocComment":""},{"DocComment":" The `RangeTo` `..end` contains all values with `x < end`."},{"DocComment":" It cannot serve as an [`Iterator`] because it doesn't have a starting point."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The `..end` syntax is a `RangeTo`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!((..5), std::ops::RangeTo { end: 5 });"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It does not have an [`IntoIterator`] implementation, so you can't use it in"},{"DocComment":" a `for` loop directly. This won't compile:"},{"DocComment":""},{"DocComment":" ```compile_fail,E0277"},{"DocComment":" // error[E0277]: the trait bound `std::ops::RangeTo<{integer}>:"},{"DocComment":" // std::iter::Iterator` is not satisfied"},{"DocComment":" for i in ..5 {"},{"DocComment":"     // ..."},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" When used as a [slicing index], `RangeTo` produces a slice of all array"},{"DocComment":" elements before the index indicated by `end`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let arr = [0, 1, 2, 3, 4];"},{"DocComment":" assert_eq!(arr[ ..  ], [0, 1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[ .. 3], [0, 1, 2      ]); // This is a `RangeTo`"},{"DocComment":" assert_eq!(arr[ ..=3], [0, 1, 2, 3   ]);"},{"DocComment":" assert_eq!(arr[1..  ], [   1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[1.. 3], [   1, 2      ]);"},{"DocComment":" assert_eq!(arr[1..=3], [   1, 2, 3   ]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [slicing index]: crate::slice::SliceIndex"}],"inline":null,"rename":null,"public"